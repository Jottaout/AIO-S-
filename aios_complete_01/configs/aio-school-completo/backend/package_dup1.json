{
  "name": "aio-school",
  "version": "1.0.0",
  "description": "All in One School — servidor completo (frontend + API)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev":              "nodemon src/server.js",
    "start":            "node src/server.js",
    "prisma:generate":  "prisma generate",
    "prisma:migrate":   "prisma migrate dev --name init",
    "prisma:deploy":    "prisma migrate deploy",
    "prisma:studio":    "prisma studio",
    "setup":            "npm install && npx prisma generate && npx prisma migrate deploy"
  },
  "dependencies": {
    "express":           "^4.19.2",
    "@prisma/client":    "^5.18.0",
    "bcryptjs":          "^2.4.3",
    "jsonwebtoken":      "^9.0.2",
    "cors":              "^2.8.5",
    "dotenv":            "^16.4.5",
    "multer":            "^1.4.5-lts.1",
    "helmet":            "^7.1.0",
    "express-rate-limit":"^7.4.0",
    "morgan":            "^1.10.0"
  },
  "devDependencies": {
    "prisma":   "^5.18.0",
    "nodemon":  "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
