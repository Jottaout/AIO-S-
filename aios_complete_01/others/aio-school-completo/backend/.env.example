# ════════════════════════════════════════════════════
#  .env — All in One School Backend
#  Copia este ficheiro para .env e preenche os valores
# ════════════════════════════════════════════════════

# Base de dados PostgreSQL
# Local:    postgresql://postgres:senha@localhost:5432/aio_school
# Neon:     postgresql://user:pass@ep-xxx.neon.tech/aio_school?sslmode=require
# Railway:  cola a "Connection URL" do painel Railway
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/aio_school"

# Porta do servidor
PORT=4000
NODE_ENV=development

# JWT — string longa e aleatória (mínimo 32 caracteres)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="substitui-por-string-aleatoria-minimo-32-caracteres"
JWT_EXPIRES_IN=7d

# URL do frontend — necessário para CORS em produção
# Em desenvolvimento: http://localhost:4000
# Em produção: https://teu-dominio.com
FRONTEND_URL="http://localhost:4000"

# Tamanho máximo de upload de ficheiros (MB)
MAX_FILE_SIZE_MB=5
